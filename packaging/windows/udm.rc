// udm Windows resource script.
//
// Provides: the asInvoker manifest (so Windows never prompts for elevation),
// the application icon, and version metadata shown in Explorer's properties
// dialog.
//
// Built by crates/gui/build.rs via the `embed-resource` crate when compiling
// on Windows (rc.exe for MSVC, windres for MinGW-w64). Set UDM_EMBED_RC=0 to
// skip it.

#include <winres.h>

#define VER_FILEVERSION          0,1,0,0
#define VER_FILEVERSION_STR      "0.1.0.0"
#define VER_PRODUCTVERSION       0,1,0,0
#define VER_PRODUCTVERSION_STR   "0.1.0"

// 1 = the application manifest (asInvoker, DPI aware, long paths)
1 RT_MANIFEST "app.manifest"

// 2 = application icon (shown in Explorer, taskbar, Alt-Tab)
2 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "udm contributors"
            VALUE "FileDescription",  "UDM - Universal Download Manager (no telemetry, no admin)"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "udm"
            VALUE "LegalCopyright",   "MIT OR Apache-2.0"
            VALUE "OriginalFilename", "udm.exe"
            VALUE "ProductName",      "UDM"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
