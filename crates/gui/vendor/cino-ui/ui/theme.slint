// cino-ui: design tokens (EasyKey design language: Apple-like surfaces, one
// accent, radii 14 / 10 / 7).
//
// RULE: Theme has exactly two inputs, `dark` and `accent`. Every other colour
// is derived from them, so changing either repaints the whole UI at once.
// Need a new colour? Add a derived `out property` here, never a new setting,
// and never hard-code a colour inside a component.

export global Theme {
    // --- The two inputs (Rust sets them from the saved config) ---
    in-out property <bool> dark: true;
    in-out property <color> accent: #0a7aff;

    // Curated accents: each is tested for contrast with white text on both
    // themes. Blue, green, orange, pink, purple.
    out property <[color]> accents: [#0a7aff, #34c759, #ff9500, #ff375f, #af52de];

    // --- Text ---
    out property <color> label: dark ? #f5f5f7 : #1d1d1f;
    out property <color> label2: dark ? #ebebf599 : #3c3c4399;
    out property <color> on-accent: #ffffff;

    // --- Surfaces ---
    out property <color> window-bg: dark ? #1c1c1e : #ececf0;
    out property <color> sidebar-bg: dark ? #26262899 : #f6f6f8cc;
    out property <color> group: dark ? #2c2c2e : #ffffff;
    out property <color> group-alt: dark ? #3a3a3c : #f2f2f5;
    out property <color> separator: dark ? #ffffff14 : #0000000d;
    out property <color> control-off: dark ? #48484a : #e3e3e8;
    out property <color> sidebar-sel: dark ? #ffffff1a : #0000000d;
    out property <color> scrim: #00000080;
    out property <color> shadow: #00000040;

    // --- Status (same on both themes) ---
    out property <color> success: #34c759;
    out property <color> danger: #ff3b30;
    out property <color> warning: #ff9500;
    out property <color> close-hover: #e81123;
    out property <color> close-pressed: #c42b1c;

    // --- Shape ---
    out property <length> r-window: 14px;
    out property <length> r-group: 10px;
    out property <length> r-control: 7px;
    out property <length> r-popup: 11px;

    // --- Type ---
    out property <length> fs-title: 15px;
    out property <length> fs-body: 13px;
    out property <length> fs-sub: 11.5px;
    out property <string> font: "Be Vietnam Pro";
}
