// cino-ui: vector icons on a 24-unit grid.
//
// Icons are Slint `Path`s, never colourised SVG `Image`s: the GPU renderer
// now and then drew those with pieces missing. A legacy icon (empty `parts`)
// is one stroked path plus an optional filled path, both tinted by Icon.color.
// A colored icon leaves those strings empty and paints `parts` back to front,
// each part in its own ink from IconPalette.
//
// Adding an icon: draw it on a 24x24 grid (stroke 1.4, round caps), put the
// path data in `Icons` below, and add it to the gallery. Hex literals belong
// in IconPalette only.
//
// Local UDM extension: IconPart, the `parts` field, IconPalette, and every
// glyph after `minus`. This file is not an untouched upstream snapshot.
// upstream-files.sha256 stays the baseline inventory and is not rewritten.

import { Theme } from "theme.slint";

export struct IconPart {
    stroke: string,
    fill: string,
    ink: color,
}

export struct IconData {
    stroke: string,
    fill: string,
    parts: [IconPart],
}

// Shared vivid inks. Read-only, derived from Theme.dark, no new Theme inputs
// and no change to Theme.accent. Pairs are dark / light. Solid and opaque;
// hues are not forced onto one numeric lightness.
// green = completion/resume, amber = pause/pending, red = failure/destructive,
// blue/cyan = download/navigation. `ink` is for internal detail, not a
// stand-in for a vivid hue.
export global IconPalette {
    out property <color> blue: Theme.dark ? #60a5fa : #2563eb;
    out property <color> cyan: Theme.dark ? #22d3ee : #0e7490;
    out property <color> green: Theme.dark ? #4ade80 : #15803d;
    out property <color> amber: Theme.dark ? #fbbf24 : #a16207;
    out property <color> orange: Theme.dark ? #fb923c : #c2410c;
    out property <color> red: Theme.dark ? #f87171 : #dc2626;
    out property <color> violet: Theme.dark ? #a78bfa : #7c3aed;
    out property <color> pink: Theme.dark ? #f472b6 : #be185d;
    out property <color> ink: Theme.dark ? #f5f5f7 : #1d1d1f;
}

export global Icons {
    // Sliders with knobs (General / Settings)
    out property <IconData> sliders: {
        stroke: "M 4 7 h 16 M 4 12 h 16 M 4 17 h 16",
        fill: "M 12.8 7 a 2.2 2.2 0 1 0 4.4 0 a 2.2 2.2 0 1 0 -4.4 0 M 6.8 12 a 2.2 2.2 0 1 0 4.4 0 a 2.2 2.2 0 1 0 -4.4 0 M 10.8 17 a 2.2 2.2 0 1 0 4.4 0 a 2.2 2.2 0 1 0 -4.4 0",
    };
    // Shield with a tick (Protection / Engine)
    out property <IconData> shield: {
