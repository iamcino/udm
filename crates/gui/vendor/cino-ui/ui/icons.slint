// Legacy icons (parts empty) draw the stroke in `color`, then the optional
// fill with the same fill-and-stroke behaviour as before. Colored icons
// suppress both of those paths and paint parts back to front: nonempty fill
// (transparent stroke), then nonempty stroke (transparent fill), both in
// part.ink. `color` does not tint parts. `enabled` fades the composed icon
// once; there is no second disabled glyph.
export component Icon {
    in property <IconData> icon;
    in property <color> color;
    in property <length> stroke-width: 1.4px;
    in property <bool> enabled: true;
    width: 18px;
    height: 18px;
    opacity: root.enabled ? 1.0 : 0.45;

    if root.icon.parts.length == 0: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.color;
        stroke-width: root.stroke-width;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.icon.stroke;
    }
    if root.icon.parts.length == 0 && root.icon.fill != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.color;
        stroke: root.color;
        stroke-width: root.stroke-width;
        stroke-line-join: round;
        commands: root.icon.fill;
    }

    for part in root.icon.parts: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        if part.fill != "": Path {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: part.ink;
            stroke: transparent;
            stroke-width: root.stroke-width;
            stroke-line-cap: round;
            stroke-line-join: round;
            commands: part.fill;
        }
        if part.stroke != "": Path {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: part.ink;
            stroke-width: root.stroke-width;
            stroke-line-cap: round;
            stroke-line-join: round;
            commands: part.stroke;
        }
    }
}
