// UDM token names bridge to cino-ui. The shared Theme owns all surface/text
// colours, font and shape; only UDM-specific dimensions live here.
import { Theme as CinoTheme } from "@cino-ui";
export global Theme {
    in-out property <int> mode: 0;
    in-out property <int> accent-index: 0;
    out property <bool> dark: CinoTheme.dark;
    out property <[color]> accents: [#0969da, #16743e, #ae4c00, #b83268, #7141bb];
    out property <color> accent: CinoTheme.accent;
    out property <color> accent-hi: dark ? accent.mix(#ffffff, 0.45) : accent;
    out property <color> accent-soft: accent.with-alpha(dark ? 0.25 : 0.12);
    out property <color> bg: CinoTheme.window-bg;
    out property <color> bg-raised: CinoTheme.sidebar-bg;
    out property <color> panel: CinoTheme.group;
    out property <color> panel-hi: CinoTheme.group-alt;
    out property <color> text: CinoTheme.label;
    out property <color> text-dim: CinoTheme.label2;
    out property <color> text-faint: CinoTheme.label2;
    out property <color> border: CinoTheme.separator;
    out property <color> border-soft: CinoTheme.separator;
    out property <color> ok: dark ? CinoTheme.success : #16743e;
    out property <color> warn: dark ? CinoTheme.warning : #8d5000;
    out property <color> err: dark ? CinoTheme.danger : #ba2424;
    out property <length> radius: CinoTheme.r-group;
    out property <length> radius-sm: CinoTheme.r-control;
    out property <length> gap: 14px;
    out property <length> pad: 16px;
    out property <string> family: CinoTheme.font;
    out property <color> row-hover: CinoTheme.sidebar-sel;
    out property <color> row-selected: accent-soft;
    out property <color> input-bg: CinoTheme.group-alt;
    out property <color> chip: CinoTheme.sidebar-sel;
    out property <color> track: CinoTheme.control-off;
}
