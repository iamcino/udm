import { I18n } from "i18n.slint";
import { Theme as CinoTheme, Lang, Icon, Icons, IconData } from "@cino-ui";
export { I18n }
// Sidebar navigation item (Apple HIG "source list" style): quiet until
// hovered, accent-tinted fill when selected, no left bar, no divider.
// The glyph is a colored udm icon. `color` is required by Icon and does
// not tint parts-based glyphs.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <IconData> icon;
    in property <string> badge;
    in property <bool> active: false;
    callback clicked;
    height: 30px;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.row-hover : transparent;
    border-radius: Theme.radius-sm;
    clip: true;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            width: 18px;
            alignment: center;
            Icon {
                icon: root.icon;
                color: Theme.text-dim;
                width: 18px;
                height: 18px;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.active ? Theme.text : Theme.text-dim;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            visible: root.badge != "";
            text: root.badge;
            color: root.active ? Theme.text-dim : Theme.text-faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// LIBRARY / CATEGORIES heading. The whole row is the button: keyboard
// focusable, chevron shows expanded (colored chevron-down) or collapsed
// (udm-chevron-right). The click only asks Rust to persist; the property
// flips after the acknowledged save.
component SidebarSectionToggle inherits FocusScope {
    in property <string> label;
    in property <IconData> mark;
    in property <bool> collapsed: false;
    callback toggled();
    width: 100%;
    height: 30px;
    accessible-role: button;
    accessible-label: root.collapsed ? root.label + ", " + I18n.tr("collapsed") : root.label + ", " + I18n.tr("expanded");
    accessible-action-default => { root.toggled(); }
    key-pressed(event) => {
        if (event.text == " " || event.text == "\n") {
            root.toggled();
            accept
        } else {
            reject
        }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: touch.has-hover ? Theme.row-hover : transparent;
        border-width: root.has-focus ? 1px : 0px;
        border-color: Theme.accent;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 4px;
            alignment: start;
            VerticalLayout {
                width: 16px;
                alignment: center;
                Icon {
                    icon: root.collapsed ? Icons.udm-chevron-right : Icons.chevron-down;
                    color: Theme.text-dim;
                    width: 16px;
                    height: 16px;
                }
            }
            VerticalLayout {
                width: 16px;
                alignment: center;
                Icon {
                    icon: root.mark;
                    color: Theme.text-dim;
                    width: 16px;
                    height: 16px;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.label;
                color: Theme.text-faint;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggled(); }
        }
    }
}

// Small caption above a sidebar group ("LIBRARY", "GENERAL").
component SidebarCaption inherits Text {
    in property <string> label;
    text: root.label;
    color: Theme.text-faint;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    height: 26px;
    vertical-alignment: bottom;
}

// Recessed single-line text field used by the unified toolbar.
component ToolbarField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> field-width: 240px;
    callback submit;
    height: 28px;
    width: root.field-width;
    background: Theme.input-bg;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-soft;
    clip: true;
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        font-size: 12px;
        accepted => { root.submit(); }
    }
    // hand-drawn placeholder (TextInput's placeholder-color is not in 1.6)
    Text {
        visible: root.text == "" && !input.has-focus;
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: 12px;
        overflow: elide;
    }
}

// Icon-only toolbar action. Disabled glyphs use Icon.enabled (opacity),
// not a second path. The row is a button: tab focus, Enter/Space, and a
// translated accessible label plus a hover tip.
component StripButton inherits FocusScope {
    in property <IconData> icon;
    in property <string> tip;
    in property <bool> is-enabled: false;
    callback clicked();
    width: 32px;
    height: 28px;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.is-enabled;
    accessible-action-default => { if (root.is-enabled) { root.clicked(); } }
    key-pressed(event) => {
        if (root.is-enabled && (event.text == " " || event.text == "\n")) {
            root.clicked();
            accept
        } else {
            reject
        }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        border-width: root.has-focus ? 1px : 0px;
        border-color: Theme.accent;
        background: touch.has-hover && root.is-enabled ? Theme.panel-hi : transparent;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            icon: root.icon;
            color: Theme.text;
            enabled: root.is-enabled;
        }
        touch := TouchArea {
            enabled: root.is-enabled;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        if touch.has-hover || root.has-focus: Rectangle {
            y: parent.height + 2px;
            height: 18px;
            width: tip-text.preferred-width + 8px;
            background: Theme.panel;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-soft;
            tip-text := Text {
                x: 4px;
                height: 100%;
                text: root.tip;
                font-size: 11px;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
    }
}

// Primary or quiet button with a colored icon and a translated label.
component LabeledIconButton inherits FocusScope {
    in property <string> label;
    in property <IconData> icon;
    in property <bool> primary: false;
    callback clicked();
    height: 28px;
    width: label-text.preferred-width + 40px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == " " || event.text == "\n") {
            root.clicked();
            accept
        } else {
            reject
        }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-sm;
        background: root.primary ? Theme.accent : touch.has-hover ? Theme.panel-hi : transparent;
        border-width: root.has-focus && !root.primary ? 1px : 0px;
        border-color: Theme.accent;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 10px;
            spacing: 6px;
            alignment: center;
            VerticalLayout {
                width: 16px;
                alignment: center;
                Icon {
                    width: 16px;
                    height: 16px;
                    icon: root.icon;
                    color: Theme.text;
                }
            }
            label-text := Text {
                text: root.label;
                color: root.primary ? #ffffff : Theme.text;
                font-size: 12px;
                font-weight: root.primary ? 600 : 400;
                vertical-alignment: center;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

// Filter-band utilities: the selection count, the armed bulk-remove
// confirmation, and Clear finished. Measured width, never stretched.
component UtilityCluster inherits Rectangle {
    in property <bool> armed;
    in property <int> count;
    in property <bool> show-count;
    callback confirmed();
    callback clear();
    height: 28px;
    horizontal-stretch: 0;
    width: inner.preferred-width;
    inner := HorizontalLayout {
        spacing: 8px;
        if root.show-count: Text {
            vertical-alignment: center;
            text: root.count + " " + I18n.tr("selected");
            color: Theme.accent-hi;
            font-size: 12px;
            font-weight: 600;
        }
        if root.armed: ActionButton {
            label: I18n.tr("Confirm remove") + " " + root.count + "?";
            clicked => { root.confirmed(); }
        }
        LabeledIconButton {
            icon: Icons.clear;
            label: I18n.tr("Clear finished");
            clicked => { root.clear(); }
        }
    }
}

// udm main window.
//
// Layout: dark sidebar (recessed) + content canvas (raised) + hairline
// status strip. One unified toolbar sits on the content side; there is no
// second header inside the views.

import { Theme } from "theme.slint";
import { TaskRow, TaskDetail, StatusInfo, EndpointRow, CategoryNav } from "model.slint";
import { ActionButton, Pill, ProgressBar, KeyValue } from "widgets.slint";
import { DownloadsView } from "views/downloads.slint";
import { AddView } from "views/add.slint";
import { SettingsView } from "views/settings.slint";
import { AboutView } from "views/about.slint";
import { PopupWindow } from "popup.slint";
export { PopupWindow }
import { HandoffWindow } from "handoff.slint";
export { HandoffWindow }
import { DetailWindow } from "detail.slint";
export { DetailWindow }
import { IconExportProof } from "icon_export_proof.slint";
import { IconGalleryCapture } from "icon_gallery_capture.slint";
export { IconGalleryCapture }
import { ScrollView, Palette } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Universal Download Manager";
    icon: @image-url("../assets/icon.png");
    // Restore-repaint pulse: flipping this property changes the window
    // background by an invisible 3%, which dirties the full window and
    // forces the software renderer to repaint everything (see
    // state::repaint_guard). The two states are visually identical.
    background: root.repaint-pulse ? Theme.bg.brighter(1.03) : Theme.bg;
    default-font-family: Theme.family;
    default-font-size: 13px;
    preferred-width: 1040px;
    preferred-height: 640px;
    min-width: 800px;
    min-height: 460px;
    // View content must not become a native maximum track size. A generous,
    // stable bound prevents a tab switch from resizing the software surface
    // during a redraw; Windows still maximizes to the monitor work area.
    max-width: 100000px;
    max-height: 100000px;

    // 0 = downloads, 1 = add, 2 = settings, 3 = about
    in-out property <int> view: 0;
    in-out property <int> theme-index <=> Theme.mode;
    // G3: theme preference as stored in Settings: 0 dark, 1 light, 2 auto
    // (follow the OS). theme-index stays the resolved dark/light value.
    in-out property <int> theme-pref: 0;
    // G3 lifecycle settings (mirror of the SettingsView controls).
    in-out property <bool> set-close-to-tray: true;
    in-out property <bool> set-minimize-to-tray: false;
    in-out property <bool> set-start-minimized: false;
    // Restore-repaint guard state (state::repaint_guard flips this for a
    // few poll ticks after the window becomes visible again).
    in-out property <bool> repaint-pulse: false;
    // G3 startup option: the toggle mirrors the actual HKCU Run entry;
    // the warning flags a Temp/Downloads executable location.
    in-out property <bool> set-start-with-windows: false;
    in-out property <bool> set-startup-location-warn: false;
    callback show-popup;
    in-out property <int> accent-index <=> Theme.accent-index;
    in-out property <int> language-index <=> I18n.language;
    in-out property <ColorScheme> native-color-scheme <=> Palette.color-scheme;
    public function apply-native-theme() {
        // theme-index is the resolved dark/light value; for the Auto
        // preference the Rust side resolves it from the OS scheme (see
        // state::os_prefers_dark) before invoking this function.
        if (root.theme-pref != 2) {
            root.theme-index = root.theme-pref;
        }
        CinoTheme.dark = root.theme-index == 0;
        CinoTheme.accent = Theme.accents[min(max(root.accent-index, 0), 4)];
        Lang.english = root.language-index == 0;
        root.native-color-scheme = root.theme-pref == 2 ? ColorScheme.unknown
            : root.theme-index == 1 ? ColorScheme.light : ColorScheme.dark;
    }
    callback appearance-changed;
    public pure function translate(key: string) -> string { return I18n.tr(key); }
    // Sidebar section collapse. Rendered from the Settings snapshot; the
    // click callback persists through Engine::save_settings and Rust writes
    // these back only after that write's result.
    in-out property <bool> sidebar-library-collapsed: false;
    in-out property <bool> sidebar-categories-collapsed: false;
    callback sidebar-section-toggled(int);
    // kind 1 = Finished, kind 2 = Unfinished, kind 0 = a category id.
    // Empty id is All categories. Anything else is a custom rule.
    public pure function category-icon(id: string, kind: int) -> IconData {
        if (kind == 1) { return Icons.udm-check; }
        if (kind == 2) { return Icons.unfinished; }
        if (id == "") { return Icons.all-categories; }
        if (id == "documents") { return Icons.documents; }
        if (id == "music") { return Icons.music; }
        if (id == "videos") { return Icons.videos; }
        if (id == "images") { return Icons.images; }
        if (id == "archives") { return Icons.archives; }
        if (id == "programs") { return Icons.programs; }
        if (id == "disk-images") { return Icons.disk-images; }
        if (id == "other") { return Icons.other; }
        return Icons.custom-category;
    }
    // downloads-list filter: 0 = all, 1 = active, 2 = completed, 3 = failed, 4 = unfinished
    in-out property <int> library: 0;
    // category axis: empty = every category. ANDs with library and the search box.
    in-out property <string> category: "";
    in property <[CategoryNav]> category-nav;
    // substring filter on the file name, applied in Rust
    in-out property <string> filter;

    // Toolbar bands. Content width is the window minus the 220px sidebar
    // and 16px of padding on each side. Quick URL is min(600, 75%) with a
    // 240px floor after the submit button. Filter is min(320, 50%) with a
    // 120px floor. Neither field stretches.
    property <length> content-w: root.width - 220px - 32px;
    property <length> url-ideal: min(600px, content-w * 0.75);
    property <length> url-submit-w: add-m.preferred-width + 22px;
    property <length> url-w: max(240px, min(url-ideal, content-w - url-submit-w - 8px));
    property <length> filter-w: max(120px, min(320px, content-w * 0.5));
    property <bool> count-tight: root.width < 920px;
    property <length> utility-w: (root.selected-count > 0 && !root.count-tight ? count-m.preferred-width + 8px : 0px)
        + (root.bulk-remove-armed ? remove-m.preferred-width + 30px : 0px)
        + clear-measure.preferred-width + 48px;
    property <bool> utility-wrap: root.filter-w + root.utility-w > root.content-w;
    // Action-strip enablement, published from the selection. Retry replaces
    // the Resume slot only for exactly one Failed task.
    in-out property <bool> can-strip-resume: false;
    in-out property <bool> can-strip-pause: false;
    in-out property <bool> can-strip-cancel: false;
    in-out property <bool> can-strip-remove: false;
    in-out property <bool> can-strip-open: false;
    in-out property <bool> can-strip-folder: false;
    in-out property <bool> can-strip-copy: false;
    in-out property <bool> can-strip-retry: false;
    callback strip-resume();
    callback strip-pause();
    callback strip-cancel();
    callback strip-remove();
    callback strip-open-file();
    callback strip-open-folder();
    callback strip-copy-url();

    in property <[TaskRow]> tasks;
    in property <TaskDetail> detail;
    in-out property <bool> detail-visible: false;
    callback close-detail;
    in property <int> selected-count: 0;
    in-out property <bool> bulk-remove-armed: false;
    callback fit-column(int) -> length;
    callback toggle-selection(string);
    callback row-clicked(string, bool, bool);
    callback select-all;
    callback clear-selection;
    callback bulk-pause;
    callback bulk-resume;
    callback bulk-remove;
    out property <bool> table-needs-scroll-clamp: downloads.needs-scroll-clamp;
    public function clamp-table-scroll() { downloads.clamp-scroll(); }
    in property <string> measure-text;
    in property <float> measure-font-size: 13;
    out property <length> measured-text-width: column-measure.preferred-width;
    // One font-metric probe, used only on a divider double-click. No repeated
    // hidden rows or approximate character-width arithmetic on UI ticks.
    column-measure := Text {
        visible: false;
        text: root.measure-text;
    }
    // G1 font-metric probes for the toolbar action labels (12px), so row 2
    // can budget each button exactly what its current-language label needs.
    // Invisible and layout-free, same pattern as column-measure above.
    add-m := Text { visible: false; font-size: 12px; font-weight: 600; text: I18n.tr("Add"); }
    remove-m := Text { visible: false; font-size: 12px; text: I18n.tr("Confirm remove") + " " + root.selected-count + "?"; }
    count-m := Text { visible: false; font-size: 12px; font-weight: 600; text: root.selected-count + " " + I18n.tr("selected"); }
    clear-measure := Text { visible: false; font-size: 12px; text: I18n.tr("Clear finished"); }
    in property <StatusInfo> status;
    in property <[EndpointRow]> endpoints;
    in property <string> version-text;
    in property <bool> http3-available;

    // add form
    in-out property <string> add-urls;
    in-out property <string> add-dir;
    in-out property <string> add-hash;
    in-out property <int> add-segments: 8;
    in-out property <int> add-transport-index: 0;
    in-out property <bool> add-paused: false;
    in-out property <string> add-preview;

    // settings form
    in-out property <string> set-download-dir;
    in-out property <int> set-max-tasks: 3;
    in-out property <int> set-segments: 8;
    in-out property <int> set-transport-index: 0;
    in-out property <int> set-conflict-index: 0;
    in-out property <bool> set-http3: true;
    in-out property <bool> set-proxy: true;
    in-out property <bool> set-verify: true;
    in-out property <bool> set-auto-categorize: false;
    in-out property <string> set-user-agent;
    in-out property <int> set-log-index: 3;

    // updater surface (wiring W2). The checkbox mirrors the flag file on
    // the install base; it is not a Settings field and Save never writes it.
    in-out property <bool> set-checks-enabled: false;
    in-out property <bool> update-available: false;
    in-out property <bool> update-check-busy: false;
    in-out property <string> update-result: "";

    // Browser integration (envelope rev.5 items 1-2): mirror of the
    // SettingsView browser rows. Toggles are immediate callbacks.
    in-out property <bool> set-chrome-enabled: false;
    in-out property <bool> set-firefox-enabled: false;
    in-out property <string> set-chrome-extension-id;
    in property <int> set-chrome-status: 1;
    in property <int> set-firefox-status: 1;
    in property <string> set-chrome-last-connected;
    in property <string> set-firefox-last-connected;
    in property <bool> set-chrome-broken: false;
    in property <bool> set-firefox-broken: false;
    in-out property <bool> set-chrome-guide-visible: false;
    in-out property <bool> set-firefox-guide-visible: false;
    in property <bool> set-browser-hint-visible: false;

    // notifications
    in-out property <string> toast: "";
    in-out property <bool> toast-error: false;

    // callbacks into Rust
    callback pause(float);
    callback resume(float);
    callback cancel(float);
    callback retry(float);
    callback remove(float);
    callback delete-file(float);
    callback copy-url(float);
    callback open-file(float);
    callback open-folder(float);
    callback add-submitted;
    callback add-pick-dir;
    callback add-dir-edited;
    callback add-urls-edited;
    callback settings-pick-dir;
    callback settings-saved;
    callback settings-reset;
    callback set-checks-toggled(bool);
    callback set-browser-toggled(string, bool);
    callback set-browser-hint-dismissed;
    callback update-check-clicked;
    callback update-apply-clicked;
    callback open-data-dir;
    callback open-log;
    callback open-github;
    callback open-gitlab;
    callback clear-finished;
    callback add-from-clipboard;
    callback dismiss-notice(string);

    // Resolves the @cino-ui icon re-exports in this compilation unit.
    // `if false` keeps the proof out of layout and off the shipping surface.
    if false: IconExportProof {}

    // Absolute shell bounds keep view-specific layout hints from resizing the
    // native window during a redraw. Only the content inside this shell flexes.
    Rectangle {
        // A real painted surface invalidates the entire software-rendered frame
        // when the palette changes, including transparent gaps between controls.
        background: Theme.bg;
        width: 100%;
        height: 100%;

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: max(root.height - 29px - (root.toast != "" ? 32px : 0px), 0px);
            min-height: 0px;
            vertical-stretch: 1;

            // ------------------------------------------------------- sidebar
            Rectangle {
                width: 220px;
                height: 100%;
                clip: true;
                vertical-stretch: 1;
                background: Theme.bg-raised;

                // brand row
                HorizontalLayout {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    spacing: 8px;
                    height: 40px;
                    alignment: start;
                    Image {
                        source: @image-url("../assets/icon-256.png");
                        width: 26px;
                        height: 26px;
                        y: 7px;
                    }
                    Text {
                        text: "UDM";
                        height: 40px;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    HorizontalLayout { horizontal-stretch: 1; }
                }

                // The category list grows with the effective rules.
                // The nav is clipped in the band between the brand and
                // the storage card so extra rows scroll.
                Rectangle {
                    clip: true;
                    x: 8px;
                    y: 60px;
                    width: parent.width - 16px;
                    // Leave the brand and the storage card outside this
                    // clip. Reading the card's own height here collapses
                    // to 0 and the nav paints through the card.
                    height: max(parent.height - 220px, 72px);
                    nav-scroll := ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            spacing: 2px;
                            width: parent.width;

                            SidebarSectionToggle {
                                label: I18n.tr("LIBRARY");
                                mark: Icons.library;
                                collapsed: root.sidebar-library-collapsed;
                                toggled => { root.sidebar-section-toggled(0); }
                            }
                            // `if` drops the rows from the layout. visible:false
                            // would keep the slot.
                            if !root.sidebar-library-collapsed: VerticalLayout {
                                spacing: 2px;
                                width: parent.width;
                                NavItem {
                                    icon: Icons.all-downloads;
                                    label: I18n.tr("All Downloads");
                                    badge: root.status.active-count + root.status.queued-count
                                        + root.status.paused-count + root.status.completed-count
                                        + root.status.failed-count > 0
                                        ? (root.status.active-count + root.status.queued-count
                                            + root.status.paused-count + root.status.completed-count
                                            + root.status.failed-count) + ""
                                        : "";
                                    active: root.view == 0 && root.library == 0;
                                    clicked => { root.view = 0; root.library = 0; }
                                }
                                NavItem {
                                    icon: Icons.active-downloads;
                                    label: I18n.tr("Active");
                                    badge: root.status.active-count + root.status.queued-count > 0
                                        ? (root.status.active-count + root.status.queued-count) + "" : "";
                                    active: root.view == 0 && root.library == 1;
                                    clicked => { root.view = 0; root.library = 1; }
                                }
                                NavItem {
                                    icon: Icons.udm-check;
                                    label: I18n.tr("Completed");
                                    badge: root.status.completed-count > 0 ? root.status.completed-count + "" : "";
                                    active: root.view == 0 && root.library == 2;
                                    clicked => { root.view = 0; root.library = 2; }
                                }
                                NavItem {
                                    icon: Icons.failed;
                                    label: I18n.tr("Failed");
                                    badge: root.status.failed-count > 0 ? root.status.failed-count + "" : "";
                                    active: root.view == 0 && root.library == 3;
                                    clicked => { root.view = 0; root.library = 3; }
                                }
                                NavItem {
                                    icon: Icons.active-downloads;
                                    label: I18n.tr("Active downloads…");
                                    badge: "";
                                    active: false;
                                    clicked => { root.show-popup(); }
                                }
                            }

                            SidebarSectionToggle {
                                label: I18n.tr("CATEGORIES");
                                mark: Icons.grid;
                                collapsed: root.sidebar-categories-collapsed;
                                toggled => { root.sidebar-section-toggled(1); }
                            }
                            if !root.sidebar-categories-collapsed: VerticalLayout {
                                spacing: 2px;
                                width: parent.width;
                                for item in root.category-nav: NavItem {
                                    icon: root.category-icon(item.id, item.kind);
                                    label: item.label;
                                    badge: item.badge;
                                    active: root.view == 0 && (item.kind == 0 ? root.category == item.id
                                        : item.kind == 1 ? root.library == 2
                                        : root.library == 4);
                                    clicked => {
                                        root.view = 0;
                                        if (item.kind == 0) {
                                            root.category = item.id;
                                        } else if (item.kind == 1) {
                                            root.library = 2;
                                        } else {
                                            root.library = 4;
                                        }
                                    }
                                }
                            }

                            SidebarCaption { label: I18n.tr("GENERAL"); }
                            NavItem {
                                icon: Icons.udm-sliders;
                                label: I18n.tr("Settings");
                                active: root.view == 2;
                                clicked => { root.view = 2; }
                            }
                            NavItem {
                                icon: Icons.udm-info;
                                label: I18n.tr("About & Privacy");
                                active: root.view == 3;
                                clicked => { root.view = 3; }
                            }
                        }
                    }
                }

                // storage widget: linear bar, no gauge (HIG: quiet, flat)
                storage-box := Rectangle {
                        x: 12px;
                        y: parent.height - self.height - 12px;
                        width: parent.width - 24px;
                        height: storage-col.preferred-height + 20px;
                        background: Theme.panel;
                        border-radius: Theme.radius;
                        storage-col := VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            Text {
                                text: I18n.tr("STORAGE");
                                color: Theme.text-faint;
                                font-size: 10px;
                                font-weight: 600;
                                letter-spacing: 1px;
                            }
                            Text {
                                text: root.status.disk-text != "" ? root.status.disk-text : "measuring…";
                                color: Theme.text;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Rectangle {
                                height: 4px;
                                background: Theme.track;
                                border-radius: 2px;
                                clip: true;
                                Rectangle {
                                    x: 0px;
                                    width: parent.width * min(max(root.status.disk-fraction, 0), 1);
                                    height: parent.height;
                                    border-radius: 2px;
                                    background: root.status.disk-fraction > 0.9 ? Theme.warn : Theme.accent;
                                }
                            }
                        }
                    }

            }

            // ------------------------------------------------------- content
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                // Hard width: the table rows position their columns
                // absolutely off the row width, and the layout's implicit
                // min-width propagation would otherwise keep this pane at its
                // preferred (too wide) size and clip the right-hand columns.
                width: root.width - 220px;
                height: 100%;
                clip: true;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    vertical-stretch: 1;
                    // Toolbar stays in the tree on every view so Add Download
                    // remains reachable from Add, Settings, and About. The
                    // action, URL, and filter bands are the task list only.
                    Rectangle {
                        height: toolbar-col.preferred-height;
                        clip: true;
                        toolbar-col := VerticalLayout {
                            padding-left: Theme.pad;
                            padding-right: Theme.pad;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                LabeledIconButton {
                                    primary: true;
                                    icon: Icons.download;
                                    label: I18n.tr("Add Download");
                                    clicked => { root.view = 1; }
                                }
                                if root.view == 0: HorizontalLayout {
                                    spacing: 2px;
                                    StripButton {
                                        icon: root.can-strip-retry ? Icons.udm-refresh : Icons.play;
                                        tip: root.can-strip-retry ? I18n.tr("Retry") : I18n.tr("Resume");
                                        is-enabled: root.can-strip-resume;
                                        clicked => {
                                            root.bulk-remove-armed = false;
                                            if (root.selected-count > 1) { root.bulk-resume(); }
                                            else { root.strip-resume(); }
                                        }
                                    }
                                    StripButton {
                                        icon: Icons.pause;
                                        tip: I18n.tr("Pause");
                                        is-enabled: root.can-strip-pause;
                                        clicked => {
                                            root.bulk-remove-armed = false;
                                            if (root.selected-count > 1) { root.bulk-pause(); }
                                            else { root.strip-pause(); }
                                        }
                                    }
                                    StripButton {
                                        icon: Icons.stop;
                                        tip: I18n.tr("Cancel");
                                        is-enabled: root.can-strip-cancel;
                                        clicked => { root.strip-cancel(); }
                                    }
                                    StripButton {
                                        icon: Icons.trash;
                                        tip: root.bulk-remove-armed
                                            ? I18n.tr("Confirm remove") + " " + root.selected-count + "?"
                                            : I18n.tr("Remove from List");
                                        is-enabled: root.can-strip-remove;
                                        clicked => {
                                            if (root.selected-count > 1) {
                                                if (root.bulk-remove-armed) {
                                                    root.bulk-remove-armed = false;
                                                    root.bulk-remove();
                                                } else {
                                                    root.bulk-remove-armed = true;
                                                }
                                            } else {
                                                root.bulk-remove-armed = false;
                                                root.strip-remove();
                                            }
                                        }
                                    }
                                    StripButton {
                                        icon: Icons.file;
                                        tip: I18n.tr("Open File");
                                        is-enabled: root.can-strip-open;
                                        clicked => { root.strip-open-file(); }
                                    }
                                    StripButton {
                                        icon: Icons.folder;
                                        tip: I18n.tr("Open Folder");
                                        is-enabled: root.can-strip-folder;
                                        clicked => { root.strip-open-folder(); }
                                    }
                                    StripButton {
                                        icon: Icons.link;
                                        tip: I18n.tr("Copy URL");
                                        is-enabled: root.can-strip-copy;
                                        clicked => { root.strip-copy-url(); }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.view == 0: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ToolbarField {
                                    field-width: root.url-w;
                                    text <=> root.add-urls;
                                    placeholder: I18n.tr("Paste a URL and press Enter to download");
                                    submit => { root.add-submitted(); }
                                }
                                ActionButton {
                                    label: I18n.tr("Add");
                                    primary: true;
                                    clicked => { root.add-submitted(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.view == 0 && !root.utility-wrap: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                ToolbarField {
                                    field-width: root.filter-w;
                                    text <=> root.filter;
                                    placeholder: I18n.tr("Filter downloads");
                                }
                                UtilityCluster {
                                    armed: root.bulk-remove-armed;
                                    count: root.selected-count;
                                    show-count: root.selected-count > 0 && !root.count-tight;
                                    confirmed => { root.bulk-remove-armed = false; root.bulk-remove(); }
                                    clear => { root.clear-finished(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.view == 0 && root.utility-wrap: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: start;
                                    ToolbarField {
                                        field-width: root.filter-w;
                                        text <=> root.filter;
                                        placeholder: I18n.tr("Filter downloads");
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    UtilityCluster {
                                        armed: root.bulk-remove-armed;
                                        count: root.selected-count;
                                        show-count: root.selected-count > 0 && !root.count-tight;
                                        confirmed => { root.bulk-remove-armed = false; root.bulk-remove(); }
                                        clear => { root.clear-finished(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                        // hairline under the toolbar (single divider per region)
                        Rectangle {
                            y: parent.height - 1px;
                            width: 100%;
                            height: 1px;
                            background: Theme.border-soft;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                        clip: true;
                        downloads := DownloadsView {
                            width: 100%;
                            height: 100%;
                            visible: root.view == 0;
                            tasks: root.tasks;
                            selected-count: root.selected-count;
                            fit-column(index) => { root.fit-column(index) }
                            toggle-selection(key) => { root.toggle-selection(key); }
                            row-clicked(key, ctrl, shift) => { root.row-clicked(key, ctrl, shift); }
                            select-all => { root.select-all(); }
                            clear-selection => { root.clear-selection(); }
                            pause(id) => { root.pause(id); }
                            resume(id) => { root.resume(id); }
                            cancel(id) => { root.cancel(id); }
                            retry(id) => { root.retry(id); }
                            remove(id) => { root.remove(id); }
                            dismiss(key) => { root.dismiss-notice(key); }
                            delete-file(id) => { root.delete-file(id); }
                            copy-url(id) => { root.copy-url(id); }
                            open-file(id) => { root.open-file(id); }
                            open-folder(id) => { root.open-folder(id); }
                        }
                        AddView {
                            width: 100%;
                            height: 100%;
                            visible: root.view == 1;
                            urls <=> root.add-urls;
                            dir <=> root.add-dir;
                            hash <=> root.add-hash;
                            segments <=> root.add-segments;
                            transport-index <=> root.add-transport-index;
                            paused <=> root.add-paused;
                            preview: root.add-preview;
                            dir-edited => { root.add-dir-edited(); }
                            urls-edited => { root.add-urls-edited(); }
                            pick-dir => { root.add-pick-dir(); }
                            submitted => { root.add-submitted(); }
                        }
                        SettingsView {
                            width: 100%;
                            height: 100%;
                            visible: root.view == 2;
                            theme-index <=> root.theme-index;
                            theme-pref <=> root.theme-pref;
                            close-to-tray <=> root.set-close-to-tray;
                            minimize-to-tray <=> root.set-minimize-to-tray;
                            start-minimized <=> root.set-start-minimized;
                            start-with-windows <=> root.set-start-with-windows;
                            startup-location-warn: root.set-startup-location-warn;
                            accent-index <=> root.accent-index;
                            language-index <=> root.language-index;
                            appearance-changed => { root.appearance-changed(); }
                            download-dir <=> root.set-download-dir;
                            max-tasks <=> root.set-max-tasks;
                            segments <=> root.set-segments;
                            transport-index <=> root.set-transport-index;
                            conflict-index <=> root.set-conflict-index;
                            http3 <=> root.set-http3;
                            proxy <=> root.set-proxy;
                            verify <=> root.set-verify;
                            auto-categorize <=> root.set-auto-categorize;
                            user-agent <=> root.set-user-agent;
                            log-index <=> root.set-log-index;
                            pick-dir => { root.settings-pick-dir(); }
                            saved => { root.settings-saved(); }
                            reset => { root.settings-reset(); }
                            checks-enabled <=> root.set-checks-enabled;
                            update-available <=> root.update-available;
                            update-check-busy <=> root.update-check-busy;
                            update-result <=> root.update-result;
                            checks-toggled(on) => { root.set-checks-toggled(on); }
                            check-clicked => { root.update-check-clicked(); }
                            apply-clicked => { root.update-apply-clicked(); }
                            chrome-enabled <=> root.set-chrome-enabled;
                            firefox-enabled <=> root.set-firefox-enabled;
                            chrome-extension-id <=> root.set-chrome-extension-id;
                            chrome-status: root.set-chrome-status;
                            firefox-status: root.set-firefox-status;
                            chrome-last-connected: root.set-chrome-last-connected;
                            firefox-last-connected: root.set-firefox-last-connected;
                            chrome-broken: root.set-chrome-broken;
                            firefox-broken: root.set-firefox-broken;
                            chrome-guide-visible <=> root.set-chrome-guide-visible;
                            firefox-guide-visible <=> root.set-firefox-guide-visible;
                            browser-hint-visible: root.set-browser-hint-visible;
                            browser-toggled(browser, on) => { root.set-browser-toggled(browser, on); }
                            browser-hint-dismissed => { root.set-browser-hint-dismissed(); }
                        }
                        AboutView {
                            width: 100%;
                            height: 100%;
                            visible: root.view == 3;
                            version-text: root.version-text;
                            status: root.status;
                            endpoints: root.endpoints;
                            http3-available: root.http3-available;
                            open-data-dir => { root.open-data-dir(); }
                            open-log => { root.open-log(); }
                            open-github => { root.open-github(); }
                            open-gitlab => { root.open-gitlab(); }
                        }
                    }

                    // --------------------------------- bottom Task Detail panel (Commit 2)
                    // Shown only in the downloads view while a task is focused.
                    // Closing it returns its full height to the table above.
                    Rectangle {
                        height: root.view == 0 && root.detail-visible ? 196px : 0px;
                        visible: root.view == 0 && root.detail-visible;
                        clip: true;
                        background: Theme.bg-raised;
                        Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.border-soft; }
                        VerticalLayout {
                            padding-left: Theme.pad;
                            padding-right: Theme.pad;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.detail.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {
                                    width: detail-state.width;
                                    height: 28px;
                                    detail-state := Pill {
                                        y: (parent.height - self.height) / 2;
                                        text: I18n.tr(root.detail.state-label);
                                        fg: root.detail.state == "failed" ? Theme.err
                                        : root.detail.state == "completed" ? Theme.ok
                                        : root.detail.state == "downloading" ? Theme.accent-hi
                                        : Theme.text-dim;
                                    }
                                }
                                ActionButton {
                                    compact: true;
                                    label: I18n.tr("Open");
                                    shown: root.detail.can-open-file;
                                    tint: Theme.accent-hi;
                                    clicked => { root.open-file(root.detail.id); }
                                }
                                ActionButton {
                                    compact: true;
                                    label: I18n.tr("Folder");
                                    shown: root.detail.can-open-folder;
                                    tint: Theme.text;
                                    clicked => { root.open-folder(root.detail.id); }
                                }
                                ActionButton {
                                    compact: true;
                                    label: I18n.tr("Copy URL");
                                    clicked => { root.copy-url(root.detail.id); }
                                }
                                ActionButton {
                                    compact: true;
                                    label: "×";
                                    tint: Theme.text-dim;
                                    clicked => { root.close-detail(); }
                                }
                            }
                            ProgressBar {
                                fraction: root.detail.percent;
                                failed: root.detail.state == "failed";
                                done: root.detail.state == "completed";
                            }
                            HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    KeyValue { key: I18n.tr("Progress"); value: root.detail.progress-text + (root.detail.percent >= 0 ? " (" + round(min(max(root.detail.percent, 0), 1) * 100) + "%)" : ""); }
                                    KeyValue { key: I18n.tr("URL"); value: root.detail.url; }
                                    KeyValue { key: I18n.tr("File"); value: root.detail.final-path; }
                                    KeyValue { key: I18n.tr("Destination"); value: root.detail.dest-dir; }
                                    if root.detail.error-text != "": KeyValue { key: I18n.tr("Error"); value: root.detail.error-text; value-color: Theme.err; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    KeyValue { key: I18n.tr("Speed"); value: root.detail.speed-text + (root.detail.eta-text != "" ? "  ·  " + root.detail.eta-text : ""); }
                                    KeyValue { key: I18n.tr("Segments"); value: root.detail.segments-text; }
                                    KeyValue { key: I18n.tr("Transport"); value: root.detail.transport-label; }
                                    KeyValue { key: I18n.tr("Created"); value: root.detail.created-text; }
                                    KeyValue { key: I18n.tr("Started"); value: root.detail.started-text; }
                                    KeyValue { key: I18n.tr("Finished"); value: root.detail.finished-text; }
                                    KeyValue { key: I18n.tr("Attempts"); value: root.detail.attempts-text; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: I18n.tr("Checksum");
                                    color: Theme.text-faint;
                                    font-size: 12px;
                                    width: 150px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.detail.checksum-status
                                        + (root.detail.expected-hash-text != "" ? "  ·  " + I18n.tr("Expected") + " " + root.detail.expected-hash-text + " (" + I18n.tr("preview") + ")" : "")
                                        + (root.detail.computed-hash-text != "" ? "  ·  " + I18n.tr("Computed") + " " + root.detail.computed-hash-text + " (" + I18n.tr("preview") + ")" : "");
                                    color: root.detail.checksum-verified ? Theme.ok : Theme.text-dim;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // toast bar when toolbar is hidden (e.g. Settings / About)
        if root.toast != "": Rectangle {
            y: root.height - 61px;
            width: 100%;
            height: 32px;
            background: root.toast-error ? Theme.err.with-alpha(0.12) : Theme.accent-soft;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                Text {
                    vertical-alignment: center;
                    text: root.toast;
                    color: root.toast-error ? Theme.err : Theme.accent-hi;
                    font-size: 12px;
                    font-weight: 500;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // ------------------------------------------------------- status bar
        Rectangle { y: root.height - 29px; width: 100%; height: 1px; background: Theme.border-soft; }
        Rectangle {
            y: root.height - 28px;
            width: 100%;
            height: 28px;
            background: Theme.bg-raised;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 16px;
                Text {
                    vertical-alignment: center;
                    text: "↓ " + root.status.speed-text;
                    color: root.status.active-count > 0 ? Theme.accent-hi : Theme.text-faint;
                    font-size: 11px;
                    font-weight: 600;
                }
                Text {
                    vertical-alignment: center;
                    text: root.status.active-count + " " + I18n.tr("active") + " · " + root.status.queued-count + " " + I18n.tr("queued");
                    color: Theme.text-dim;
                    font-size: 11px;
                }
                HorizontalLayout { horizontal-stretch: 1; }
            }
        }
    }
}
