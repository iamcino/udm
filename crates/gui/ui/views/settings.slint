import { AppearanceGroup, TextField } from "@cino-ui";
import { I18n } from "../i18n.slint";
// Settings form. Values live in window properties; "Save" pushes them to the
// engine, which persists them into the redb file.

import { Theme } from "../theme.slint";
import { ActionButton, SectionTitle } from "../widgets.slint";
import { LineEdit, CheckBox, SpinBox, ComboBox, ScrollView } from "std-widgets.slint";

export component SettingsView inherits Rectangle {
    in-out property <string> download-dir;
    in-out property <int> max-tasks;
    in-out property <int> segments;
    in-out property <int> transport-index;
    in-out property <int> conflict-index;
    in-out property <bool> http3;
    in-out property <bool> proxy;
    in-out property <bool> verify;
    in-out property <bool> auto-categorize;
    in-out property <string> user-agent;
    in-out property <int> log-index;
    callback pick-dir;
    callback saved;
    callback reset;
    in-out property <int> theme-index;
    in-out property <int> theme-pref;
    in-out property <bool> close-to-tray;
    in-out property <bool> minimize-to-tray;
    in-out property <bool> start-minimized;
    in-out property <bool> start-with-windows;
    in property <bool> startup-location-warn;
    in-out property <int> accent-index;
    in-out property <int> language-index;
    callback appearance-changed;
    // Updater surface: flag-file bound. Checks resolve on by default and run
    // at startup and every 6 hours, plus on manual action; applying is manual.
    in-out property <bool> checks-enabled;
    in-out property <bool> update-available;
    in-out property <bool> update-check-busy;
    in-out property <string> update-result;
    callback checks-toggled(bool);
    callback check-clicked;
    callback apply-clicked;
    // Browser integration (items 1-2): two rows, each a toggle, a
    // status light and an Install extension button. Toggles are
    // immediate callbacks, never Save-gated. Status tiers: 1 = no
    // host key, 2 = key present, no journal row, 3 = journal row
    // (last-connected holds the local time of the newest row).
    in-out property <bool> chrome-enabled;
    in-out property <bool> firefox-enabled;
    in-out property <string> chrome-extension-id;
    in property <int> chrome-status: 1;
    in property <int> firefox-status: 1;
    in property <string> chrome-last-connected;
    in property <string> firefox-last-connected;
    in property <bool> chrome-broken;
    in property <bool> firefox-broken;
    in-out property <bool> chrome-guide-visible;
    in-out property <bool> firefox-guide-visible;
    in property <bool> browser-hint-visible;
    callback browser-toggled(string, bool);
    callback browser-hint-dismissed;

    width: 100%;
    height: 100%;
    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        vertical-stretch: 1;
        padding: Theme.pad;
        spacing: 14px;

        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: start;
                VerticalLayout {
                    width: min(root.width - 48px, 580px);
                    spacing: 14px;
                    padding-right: 6px;

                    AppearanceGroup {
                        accents: Theme.accents;
                        dark-changed(on) => { root.theme-index = on ? 0 : 1; root.appearance-changed(); }
                        accent-picked(c) => {
                            root.accent-index = c == Theme.accents[0] ? 0 : c == Theme.accents[1] ? 1
                                : c == Theme.accents[2] ? 2 : c == Theme.accents[3] ? 3 : 4;
                            root.appearance-changed();
                        }
                        language-changed(english) => { root.language-index = english ? 0 : 1; root.appearance-changed(); }
                    }
                    Text { text: I18n.tr("Applied immediately; saved locally."); color: Theme.text-faint; }
                    VerticalLayout {
                        width: 280px;
                        spacing: 6px;
                        Text { text: I18n.tr("Theme"); color: Theme.text-dim; font-size: 12px; }
                        ComboBox {
                            height: 30px;
                            model: [I18n.tr("Dark"), I18n.tr("Light"), I18n.tr("Auto (follow system)")];
                            current-index <=> root.theme-pref;
                            selected => { root.appearance-changed(); }
                        }
                    }

                    SectionTitle { label: I18n.tr("WINDOW"); }
                    CheckBox {
                        text: I18n.tr("Close window to the tray");
                        checked <=> root.close-to-tray;
                    }
                    CheckBox {
                        text: I18n.tr("Minimize window to the tray");
                        checked <=> root.minimize-to-tray;
                    }
                    CheckBox {
                        text: I18n.tr("Start minimized in the tray");
                        checked <=> root.start-minimized;
                    }
                    CheckBox {
                        text: I18n.tr("Start with Windows");
                        checked <=> root.start-with-windows;
                    }
                    Text {
                        width: min(root.width - 48px, 580px);
                        text: I18n.tr("Runs UDM when you sign in to Windows. Stored only in your user account (HKCU Run); no administrator rights, no service. Remove it here or in Windows Settings > Apps > Startup.");
                        color: Theme.text-faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    if root.start-with-windows && root.startup-location-warn: Text {
                        width: min(root.width - 48px, 580px);
                        text: I18n.tr("UDM is running from Temp or Downloads. Startup will break if that folder is cleaned - consider a permanent folder.");
                        color: Theme.warn;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    SectionTitle { label: I18n.tr("QUEUE"); }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 220px;
                            spacing: 6px;
                            Text { text: I18n.tr("Parallel tasks"); color: Theme.text-dim; font-size: 12px; }
                            HorizontalLayout {
                                height: 30px;
                                SpinBox { value <=> root.max-tasks; minimum: 1; maximum: 32; }
                            }
                        }
                        VerticalLayout {
                            width: 220px;
                            spacing: 6px;
                            Text { text: I18n.tr("Connections per task"); color: Theme.text-dim; font-size: 12px; }
                            HorizontalLayout {
                                height: 30px;
                                SpinBox { value <=> root.segments; minimum: 1; maximum: 64; }
                            }
                        }
                    }

                    SectionTitle { label: I18n.tr("DESTINATION"); }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 30px;
                            background: Theme.input-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextField {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                text <=> root.download-dir;
                                placeholder: I18n.tr("default (system Downloads folder)");
                            }
                        }
                        ActionButton { label: I18n.tr("Browse..."); clicked => { root.pick-dir(); } }
                    }
                    CheckBox {
                        text: I18n.tr("Sort downloads into category subfolders");
                        checked <=> root.auto-categorize;
                    }

                    SectionTitle { label: I18n.tr("TRANSPORT"); }
                    VerticalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 280px;
                            spacing: 6px;
                            Text { text: "HTTP/3 (QUIC)"; color: Theme.text-dim; font-size: 12px; }
                            ComboBox {
                                height: 30px;
                                model: [I18n.tr("Auto - use Alt-Svc advertisements"), I18n.tr("Prefer HTTP/3"), I18n.tr("HTTP/3 only"), I18n.tr("Never HTTP/3")];
                                current-index <=> root.transport-index;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            CheckBox { text: I18n.tr("Enable QUIC / HTTP3"); checked <=> root.http3; }
                            CheckBox { text: I18n.tr("Use the system proxy for HTTP/1.1-2"); checked <=> root.proxy; }
                        }
                    }

                    SectionTitle { label: I18n.tr("INTEGRITY"); }
                    CheckBox {
                        text: I18n.tr("Verify checksums before renaming .part files");
                        checked <=> root.verify;
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 280px;
                            spacing: 6px;
                            Text { text: I18n.tr("Existing destination file"); color: Theme.text-dim; font-size: 12px; }
                            ComboBox {
                                height: 30px;
                                model: [I18n.tr("Rename to a unique name"), I18n.tr("Overwrite"), I18n.tr("Refuse to start")];
                                current-index <=> root.conflict-index;
                            }
                        }
                    }

                    SectionTitle { label: I18n.tr("IDENTITY & LOGGING"); }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: I18n.tr("User-Agent header"); color: Theme.text-dim; font-size: 12px; }
                        Rectangle {
                            height: 30px;
                            background: Theme.input-bg;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextField { x: 0px; y: 0px; width: 100%; height: 100%; text <=> root.user-agent; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            width: 280px;
                            spacing: 6px;
                            Text { text: I18n.tr("Local log level"); color: Theme.text-dim; font-size: 12px; }
                            ComboBox {
                                height: 30px;
                                model: ["off", "error", "warn", "info", "debug", "trace"];
                                current-index <=> root.log-index;
                            }
                        }
                    }

                    SectionTitle { label: I18n.tr("UPDATES"); }
                    CheckBox {
                        text: I18n.tr("Enable update checks");
                        checked <=> root.checks-enabled;
                        toggled => { root.checks-toggled(root.checks-enabled); }
                    }
                    Text {
                        width: min(root.width - 48px, 580px);
                        text: I18n.tr("On by default. UDM checks for updates at startup and every 6 hours while it runs, and when you press Check for Updates. Applying an update is always manual - nothing is installed until you press Apply. Turn this off to stop new checks from starting; a check already running finishes.");
                        color: Theme.text-faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton {
                            label: root.update-check-busy ? I18n.tr("Checking...") : I18n.tr("Check for Updates");
                            is-enabled: !root.update-check-busy;
                            clicked => { root.check-clicked(); }
                        }
                        if root.update-available: ActionButton {
                            label: I18n.tr("Apply Update");
                            primary: true;
                            clicked => { root.apply-clicked(); }
                        }
                    }
                    if root.update-result != "": Text {
                        width: min(root.width - 48px, 580px);
                        text: root.update-result;
                        color: Theme.text-dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    SectionTitle { label: I18n.tr("BROWSER INTEGRATION"); }
                    if root.browser-hint-visible: HorizontalLayout {
                        spacing: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: I18n.tr("Connect Chrome or Firefox so the browser can hand downloads to UDM. Registration writes a per-user browser key and nothing else; a connection starts only when a download is handed over.");
                            color: Theme.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        ActionButton { label: I18n.tr("Dismiss"); compact: true; clicked => { root.browser-hint-dismissed(); } }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            CheckBox {
                                text: I18n.tr("Chrome");
                                checked <=> root.chrome-enabled;
                                toggled => { root.browser-toggled("chrome", root.chrome-enabled); }
                            }
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.chrome-broken ? #c0392b : root.chrome-status == 3 ? Theme.ok : root.chrome-status == 2 ? Theme.warn : Theme.text-faint;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.chrome-broken ? I18n.tr("Registration broken — toggle off and on again to repair.")
                                    : root.chrome-status == 3 ? I18n.tr("Last connected: ") + root.chrome-last-connected
                                    : root.chrome-status == 2 ? I18n.tr("Registered — waiting for the first connection")
                                    : I18n.tr("Not registered");
                                color: Theme.text-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            ActionButton { label: I18n.tr("Install extension"); compact: true; clicked => { root.chrome-guide-visible = !root.chrome-guide-visible; } }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: I18n.tr("Extension ID"); color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px;
                                background: Theme.input-bg;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border;
                                TextField {
                                    x: 0px;
                                    y: 0px;
                                    width: 100%;
                                    height: 100%;
                                    text <=> root.chrome-extension-id;
                                    placeholder: I18n.tr("copy from the extension options page");
                                }
                            }
                        }
                        if root.chrome-guide-visible: Text {
                            text: I18n.tr("Chrome guide: the extension ships with UDM, in the extension\\chrome folder next to udm.exe (also on the release page as the udm-extension-chrome zip). Open chrome://extensions, turn on Developer mode, click Load unpacked and select that folder. Then open the extension's options page, copy its ID (chrome.runtime.id) into the field above, and turn the toggle on. UDM does not watch the browser's extension list.");
                            color: Theme.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            CheckBox {
                                text: I18n.tr("Firefox");
                                checked <=> root.firefox-enabled;
                                toggled => { root.browser-toggled("firefox", root.firefox-enabled); }
                            }
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.firefox-broken ? #c0392b : root.firefox-status == 3 ? Theme.ok : root.firefox-status == 2 ? Theme.warn : Theme.text-faint;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.firefox-broken ? I18n.tr("Registration broken — toggle off and on again to repair.")
                                    : root.firefox-status == 3 ? I18n.tr("Last connected: ") + root.firefox-last-connected
                                    : root.firefox-status == 2 ? I18n.tr("Registered — waiting for the first connection")
                                    : I18n.tr("Not registered");
                                color: Theme.text-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            ActionButton { label: I18n.tr("Install extension"); compact: true; clicked => { root.firefox-guide-visible = !root.firefox-guide-visible; } }
                        }
                        if root.firefox-guide-visible: Text {
                            text: I18n.tr("Firefox guide: the extension ships with UDM, in the extension\\firefox folder next to udm.exe (also on the release page as the udm-extension-firefox zip). Open about:debugging, choose This Firefox, click Load Temporary Add-on and select the manifest.json file inside that folder. A temporary add-on does not survive a browser restart. The extension ID is fixed (udm-handoff@cino.pw); there is no field to fill. UDM does not watch the browser's extension list.");
                            color: Theme.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: I18n.tr("After a successful register the connection starts when the lease allows and no coordinator is running yet; turning a toggle off refuses the next connection at pairing, all without a restart. Moving the portable folder is repaired on the next start.");
                        color: Theme.text-faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: I18n.tr("Settings are stored locally in the redb database. Nothing is ever uploaded.");
                min-width: 0px;
                overflow: elide;
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
            ActionButton { label: I18n.tr("Restore defaults"); clicked => { root.reset(); } }
            ActionButton { label: I18n.tr("Save"); primary: true; clicked => { root.saved(); } }
        }
    }
}
