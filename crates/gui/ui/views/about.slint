import { I18n } from "../i18n.slint";
// About / privacy / diagnostics.

import { Theme } from "../theme.slint";
import { StatusInfo, EndpointRow } from "../model.slint";
import { ActionButton, SectionTitle, KeyValue, Pill } from "../widgets.slint";
import { ListView } from "std-widgets.slint";


export component AboutView inherits Rectangle {
    in property <string> version-text;
    in property <StatusInfo> status;
    in property <[EndpointRow]> endpoints;
    in property <bool> http3-available;
    callback open-data-dir;
    callback open-log;

    width: 100%;
    height: 100%;
    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        vertical-stretch: 1;
        padding: Theme.pad;
        spacing: 14px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: "Universal Download Manager";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }
            Pill { text: root.version-text; fg: Theme.accent-hi; }
            Pill { text: root.http3-available ? I18n.tr("QUIC ready") : I18n.tr("QUIC unavailable"); fg: root.http3-available ? Theme.ok : Theme.warn; }
        }

        Text {
            width: 100%;
            text: I18n.tr("Quick, lively, greedy for connections - like a little rabbit, \nit keeps chewing through obstacles until every download lands.");
            color: Theme.text-faint;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;
            inner := VerticalLayout {
                spacing: 14px;

                SectionTitle { label: I18n.tr("PRIVACY - WHAT THIS PROGRAM NEVER DOES"); }
                Text {
                    text: I18n.tr("No analytics, crash reporting, usage statistics or device fingerprinting.\nThis build has no automatic update checks or bundled updater.\nThe app needs no administrator rights, services or scheduled tasks.\nThe installer adds an entry for uninstalling UDM under your Windows account.\nNetwork connections are made for the downloads you add.");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Text {
                    text: I18n.tr("The dependency allow-list in deny.toml rejects telemetry and analytics crates at build time,\nand tests/no_telemetry.rs fails the build if one ever sneaks back in.");
                    color: Theme.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                SectionTitle { label: I18n.tr("WHERE YOUR DATA LIVES"); }
                KeyValue { key: I18n.tr("mode"); value: I18n.tr(root.status.mode-text); }
                KeyValue { key: I18n.tr("data directory"); value: root.status.data-dir-text; }
                KeyValue { key: I18n.tr("database"); value: root.status.db-text; }

                SectionTitle { label: I18n.tr("LEARNED HTTP/3 ENDPOINTS (ALT-SVC CACHE)"); }
                Rectangle {
                    height: root.endpoints.length == 0 ? 40px : min(root.endpoints.length * 24px + 8px, 180px);
                    background: Theme.input-bg;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-soft;
                    clip: true;
                    no-ep := Text {
                        visible: root.endpoints.length == 0;
                        x: 10px; y: 10px;
                        text: I18n.tr("none yet - endpoints are learned from Alt-Svc headers and stored locally");
                        color: Theme.text-faint;
                        font-size: 11px;
                    }
                    ListView {
                        visible: root.endpoints.length > 0;
                        for ep in root.endpoints: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            height: 24px;
                            spacing: 14px;
                            Text { width: 260px; text: ep.origin; color: Theme.text; font-size: 11px; overflow: elide; }
                            Text { width: 150px; text: ep.learned-text; color: Theme.text-faint; font-size: 11px; }
                            Text { horizontal-stretch: 1; text: ep.failures-text; color: Theme.text-faint; font-size: 11px; }
                        }
                    }
                }

                SectionTitle { label: I18n.tr("STACK"); }
                Text {
                    text: I18n.tr("Rust + Slint UI + redb storage.\nHTTP/3 over QUIC (quinn + h3), automatic fallback to HTTP/2 and HTTP/1.1 (reqwest).\nTLS via rustls with the ring provider and the operating system trust store.");
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            HorizontalLayout { horizontal-stretch: 1; }
            ActionButton { label: I18n.tr("Open log file"); clicked => { root.open-log(); } }
            ActionButton { label: I18n.tr("Open data folder"); clicked => { root.open-data-dir(); } }
        }
    }
}
