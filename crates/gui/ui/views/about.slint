import { I18n } from "../i18n.slint";
// About: identity, version, author, project links and where the data lives.
// The long-form texts (privacy commitments, stack notes) live in the README
// and in docs/PRIVACY.md; this page stays a summary.

import { Theme } from "../theme.slint";
import { StatusInfo, EndpointRow } from "../model.slint";
import { ActionButton, SectionTitle, KeyValue, Pill } from "../widgets.slint";


// A project-link button with the service's brand mark, mirroring
// ActionButton's geometry and hover language (Yeager's About carries
// the same brand buttons; the marks live in assets/links).
component BrandButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked;
    preferred-width: label-text.preferred-width + 46px;
    height: 28px;
    background: touch.pressed ? Theme.panel-hi : touch.has-hover ? Theme.panel-hi : transparent;
    border-radius: Theme.radius-sm;
    clip: true;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 7px;
        alignment: center;
        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            vertical-alignment: center;
        }
        label-text := Text {
            text: root.label;
            color: touch.has-hover ? Theme.text : Theme.text-dim;
            font-size: 12px;
            font-weight: touch.has-hover ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AboutView inherits Rectangle {
    in property <string> version-text;
    in property <StatusInfo> status;
    in property <[EndpointRow]> endpoints;
    in property <bool> http3-available;
    callback open-data-dir;
    callback open-log;
    callback open-github;
    callback open-gitlab;

    width: 100%;
    height: 100%;
    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        vertical-stretch: 1;
        padding: Theme.pad;
        spacing: 14px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: "Universal Download Manager";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }
            Pill { text: root.version-text; fg: Theme.accent-hi; }
            Pill { text: root.http3-available ? I18n.tr("QUIC ready") : I18n.tr("QUIC unavailable"); fg: root.http3-available ? Theme.ok : Theme.warn; }
        }

        Text {
            width: 100%;
            text: I18n.tr("Quick, lively, greedy for connections - like a little rabbit, \nit keeps chewing through obstacles until every download lands.");
            color: Theme.text-faint;
            font-size: 12px;
            wrap: word-wrap;
        }

        SectionTitle { label: I18n.tr("WHERE YOUR DATA LIVES"); }
        KeyValue { key: I18n.tr("mode"); value: I18n.tr(root.status.mode-text); }
        KeyValue { key: I18n.tr("data directory"); value: root.status.data-dir-text; }
        KeyValue { key: I18n.tr("database"); value: root.status.db-text; }

        SectionTitle { label: I18n.tr("PROJECT"); }
        Text {
            text: "© 2026 Cino";
            color: Theme.text-dim;
            font-size: 12px;
        }
        Text {
            width: 100%;
            text: I18n.tr("Dual-licensed under the MIT License or the Apache License 2.0, at your option.");
            color: Theme.text-faint;
            font-size: 11px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            BrandButton { icon: Theme.dark ? @image-url("../../assets/links/github-dark.svg") : @image-url("../../assets/links/github.svg"); label: "GitHub"; clicked => { root.open-github(); } }
            BrandButton { icon: @image-url("../../assets/links/gitlab.svg"); label: "GitLab"; clicked => { root.open-gitlab(); } }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 10px;
            HorizontalLayout { horizontal-stretch: 1; }
            ActionButton { label: I18n.tr("Open log file"); clicked => { root.open-log(); } }
            ActionButton { label: I18n.tr("Open data folder"); clicked => { root.open-data-dir(); } }
        }
    }
}
